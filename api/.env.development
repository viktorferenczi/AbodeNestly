# Local development against `supabase start` (SPEC §3 Environments).
# Keys printed by `supabase status` are local-only; paste them into .env.development.local
# (git-ignored) rather than here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=
# Test-only: integration tests sign up users through GoTrue with the anon key.
SUPABASE_ANON_KEY=
API_BASE_URL=http://localhost:3000
CRON_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OPENFOODFACTS_USER_AGENT=
