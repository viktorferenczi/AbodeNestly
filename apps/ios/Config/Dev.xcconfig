// Dev environment (SPEC §3). Committed; points at `supabase start` and the local API.
// `/$()/` stops xcconfig treating `//` as a comment.
PRODUCT_BUNDLE_IDENTIFIER = com.abodenestly.app.dev
API_BASE_URL = http:/$()/localhost:3000
SUPABASE_URL = http:/$()/127.0.0.1:54321
// The web app's origin; invite links are `<WEB_BASE_URL>/join/<code>`.
WEB_BASE_URL = http:/$()/localhost:5173
// Custom URL scheme for the magic-link and Google callback (`<scheme>://auth/callback`).
AUTH_URL_SCHEME = abodenestly-dev
// Paste the local anon key from `supabase status` into Dev.local.xcconfig (git-ignored).
SUPABASE_ANON_KEY =

#include? "Dev.local.xcconfig"
