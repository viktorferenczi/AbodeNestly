# Local development against `supabase start`. Put the anon key from `supabase status`
# in .env.development.local (git-ignored).
# Same-origin path; vite.config.ts proxies /api/* to the local API on :3000 (the API has no CORS).
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
